  "shared_appendix": "\n/* In-page destinations follow the standard header: relative on phones,\n   fixed and rem-aware on desktop. Keep breathing room without root padding. */\n:root { --fc-anchor-offset: 16px; }\n@media (min-width: 1021px) {\n    :root { --fc-anchor-offset: calc(max(52px, 3.25rem) + 16px); }\n}\n\n/* Existing native destinations without a page-specific offset. */\nbody.fc-site #aaronic-priesthood-restoration,\nbody.fc-site #ask-history,\nbody.fc-site #ask-pioneers,\nbody.fc-site #atonement-title,\nbody.fc-site #christ-understands,\nbody.fc-site #commission-heading,\nbody.fc-site #early-missionaries-heading,\nbody.fc-site #guided-reflections,\nbody.fc-site #history-bom-evidence-title,\nbody.fc-site #history-first-vision-title,\nbody.fc-site #history-harmony-title,\nbody.fc-site #joseph-likeness-entry,\nbody.fc-site #kirtland-safety-society,\nbody.fc-site #kirtland-temple,\nbody.fc-site #liberty-jail-study,\nbody.fc-site #likeness-title,\nbody.fc-site #love-share-invite-heading,\nbody.fc-site #melchizedek-priesthood-restoration,\nbody.fc-site #nauvoo-legion,\nbody.fc-site #nauvoo-temple,\nbody.fc-site #pioneer-departure-heading,\nbody.fc-site #pioneer-trail-life-heading,\nbody.fc-site #porter-rockwell,\nbody.fc-site #receiving-care,\nbody.fc-site #relief-society-organization,\nbody.fc-site #richmond-rebuke,\nbody.fc-site #scripture-companion,\nbody.fc-site #visit-heading,\nbody.fc-site #ways-to-serve,\nbody.fc-site #worldwide-heading { scroll-margin-top: var(--fc-anchor-offset, 16px); }\n",
